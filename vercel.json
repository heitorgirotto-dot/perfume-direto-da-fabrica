{
  "functions": {
    "api/checkout.js": {
      "maxDuration": 10
    },
    "api/pagina.js": {
      "includeFiles": "{index.html,produtos.json}"
    }
  },
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/api/pagina?tipo=blog"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/pagina?tipo=post&slug=:slug"
    },
    {
      "source": "/p/:slug",
      "destination": "/api/pagina?tipo=p&slug=:slug"
    },
    {
      "source": "/c/:slug",
      "destination": "/api/pagina?tipo=c&slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/pagina?tipo=sitemap"
    },
    {
      "source": "/api/taxas",
      "destination": "/api/pagina?tipo=taxas"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/painel",
      "destination": "/admin.html"
    },
    {
      "source": "/afiliado",
      "destination": "/afiliado.html"
    }
  ],
  "headers": [
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/produtos.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/(img|fotos|fotos-king)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "notaperfumaria.vercel.app"
        }
      ],
      "destination": "https://notaperfumaria.com/:path*",
      "permanent": true
    }
  ]
}