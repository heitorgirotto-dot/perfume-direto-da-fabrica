{
  "functions": {
    "api/checkout.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/painel",
      "destination": "/admin.html"
    },
    {
      "source": "/afiliado",
      "destination": "/afiliado.html"
    }
  ],
  "headers": [
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "notaperfumaria.vercel.app"
        }
      ],
      "destination": "https://notaperfumaria.com/:path*",
      "permanent": true
    }
  ]
}